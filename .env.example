# HydraDB graph-node (see ../README.md or the HydraDB repo's own README for
# how to bring one up locally with `docker run ghcr.io/hydra-db/hydradb`)
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0

# Used for fact/entity extraction from session transcripts (src/lib/extract.ts)
ANTHROPIC_API_KEY=
