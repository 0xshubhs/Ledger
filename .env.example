# HydraDB graph-node (see README for how to bring one up locally with Docker)
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0

# ---------------------------------------------------------------------------
# LLM backend, used for fact extraction, query planning, answer synthesis and
# eval grading. Two options; leave LLM_PROVIDER unset to auto-detect (Claude if
# ANTHROPIC_API_KEY is present, otherwise a local OpenAI-compatible server).
# ---------------------------------------------------------------------------

# Option A — local, no API key. Works with Ollama out of the box:
#   ollama pull qwen3.5:4b && ollama serve
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b

# Same code path serves llama.cpp's llama-server, including the TurboQuant
# build in ../localAI (python3 serve.py) — only the URL changes:
#   LLM_BASE_URL=http://localhost:8080/v1
#   LLM_MODEL=Qwen3-8B-Q4_K_M

# Grade with a different (ideally stronger) model than the one under test, so
# the system is not marking its own homework. Defaults to LLM_MODEL.
# LLM_JUDGE_MODEL=qwen3.5:9b

# If your local server requires a bearer token:
# LLM_API_KEY=

# Option B — Claude API. Setting this alone is enough; auto-detect picks it up.
# ANTHROPIC_API_KEY=

# Path to a LongMemEval split, so scripts/run-eval.mjs can be run without --dataset
# LONGMEMEVAL_PATH=data/longmemeval_oracle.json
